---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'Contact — ToDay';
const description = 'Get in touch with ToDay. We respond within one business day.';
---

<MainLayout title={title} description={description}>

  <!-- =========================================================
       SECTION 1 — HERO
       Full-bleed editorial lifestyle image with minimal typography
       ========================================================= -->
  <section
    class="relative h-[80dvh] min-h-[520px] w-full overflow-hidden"
    aria-label="Contact hero"
  >
    <img
      src="/images/contact-hero.png"
      alt="A sunlit outdoor terrace with teak furniture and linen textiles at golden hour"
      width="1920"
      height="1080"
      class="absolute inset-0 h-full w-full object-cover object-[center_70%]"
      loading="eager"
      decoding="async"
    />
    <!-- Restrict the gradient to only the bottom quarter so it doesn't cover the subject -->
    <div id="hero-gradient" class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-footer-bg to-transparent opacity-0" />
    <div class="absolute inset-0 bg-white/10 mix-blend-overlay" />

    <div class="absolute inset-x-0 bottom-0 flex flex-col justify-end px-6 pb-16 sm:px-10 lg:px-16 lg:pb-20">
      <p id="hero-kicker" class="mb-4 text-sm font-semibold tracking-[0.18em] text-brand uppercase opacity-0">
        ToDay — Contact
      </p>
      <h1
        id="hero-title"
        class="max-w-[1200px] text-3xl font-display-light leading-[1.1] text-text-heading sm:text-[3rem] lg:text-[4.2rem] whitespace-pre-line opacity-0"
      >We don't send questionnaires.
We have conversations.</h1>
      <p id="hero-subtitle" class="mt-5 max-w-md text-base leading-relaxed text-text-body opacity-0">
        Tell us about your project — our team will respond within one business day.
      </p>
    </div>
  </section>

  <script>
    import { gsap } from "gsap";
    
    // GSAP Timeline for Hero
    const tl = gsap.timeline();
    
    tl.fromTo("#hero-gradient", 
      { y: "100%", opacity: 0 }, 
      { y: "0%", opacity: 1, duration: 1.2, ease: "power3.out" }
    );

    tl.fromTo("#hero-kicker", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
      "<0.4"
    );

    tl.fromTo("#hero-title", 
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" },
      "<0.2"
    );

    tl.fromTo("#hero-subtitle",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
      "<0.3"
    );
  </script>

  <!-- =========================================================
       SECTION 2 — FORM + CHANNELS
       Two-column: contact channels (left) + enquiry form (right)
       ========================================================= -->
  <section
    class="bg-footer-bg px-4 py-24 sm:px-6 lg:px-8 lg:py-40 overflow-hidden"
    aria-label="Get in touch"
  >
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-16 lg:grid-cols-[4fr_6fr] lg:gap-24">

        <!-- LEFT — Direct channels & Atmosphere -->
        <div class="flex flex-col contact-reveal">
          <p class="mb-3 caption-label text-brand">Get in Touch</p>
          <h2 class="mb-4 text-[2.2rem] font-display-medium leading-tight text-text-heading sm:text-[2.6rem]">
            We'd love to hear from you
          </h2>
          <p class="mb-12 max-w-sm text-base leading-relaxed text-text-muted">
            Visit our showroom, send us a message, or pick up the phone.
            Whatever works best for you.
          </p>

          <div class="relative aspect-[3/4] w-full overflow-hidden mb-12 contact-reveal-image">
            <img 
              src="https://images.unsplash.com/photo-1599696848652-f0ff23bc911f?w=800&q=85&auto=format&fit=crop" 
              alt="Sunlight hitting teak wood chair" 
              class="h-full w-full object-cover transition-transform duration-[1.2s] ease-out scale-105" 
            />
          </div>

          <div class="space-y-8">
            <div class="contact-reveal">
              <p class="text-xs font-semibold tracking-[0.14em] text-text-muted uppercase">Phone</p>
              <a href="tel:+15550000000" class="mt-1 block text-lg font-display-medium text-text-heading transition-colors hover:text-brand">
                +1 (555) 000-0000
              </a>
            </div>
            <div class="contact-reveal">
              <p class="text-xs font-semibold tracking-[0.14em] text-text-muted uppercase">Email</p>
              <a href="mailto:hello@today-outdoor.com" class="mt-1 block text-lg font-display-medium text-text-heading transition-colors hover:text-brand">
                hello@today-outdoor.com
              </a>
            </div>
            <div class="contact-reveal">
              <p class="text-xs font-semibold tracking-[0.14em] text-text-muted uppercase">Showroom</p>
              <p class="mt-1 text-lg font-display-medium text-text-heading">1234 Grove Street<br/><span class="text-base text-text-body font-sans">Los Angeles, CA 90012</span></p>
              <p class="mt-1 text-xs text-text-muted">Tue – Sat · 10am – 6pm</p>
            </div>
          </div>
        </div>

        <!-- RIGHT — Conversational Enquiry Form -->
        <div class="flex flex-col justify-center lg:pl-10">
          <form
            id="contact-enquiry-form"
            action="#"
            method="post"
            class="space-y-12"
            aria-label="Enquiry form"
          >
            <!-- Honeypot Field (Spam Protection) -->
            <input
              type="text"
              name="b_field"
              id="contact-honeypot"
              class="hidden opacity-0 pointer-events-none absolute -z-10"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <!-- Name -->
            <div class="relative group contact-reveal">
              <label
                for="contact-name"
                class="mb-4 block text-sm font-semibold tracking-[0.14em] text-brand uppercase transition-colors"
              >
                How should we refer to you? *
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                placeholder="Your Name"
                required
                class="w-full border-b border-border-strong bg-transparent px-0 py-3 text-2xl font-display-light text-text-heading placeholder:text-text-muted/40 transition-colors focus:border-brand focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Email -->
            <div class="relative group contact-reveal">
              <label
                for="contact-email"
                class="mb-4 block text-sm font-semibold tracking-[0.14em] text-brand uppercase transition-colors"
              >
                Where can we reach you? *
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                placeholder="Email Address"
                required
                class="w-full border-b border-border-strong bg-transparent px-0 py-3 text-2xl font-display-light text-text-heading placeholder:text-text-muted/40 transition-colors focus:border-brand focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Company (Optional) -->
            <div class="relative group contact-reveal">
              <label
                for="contact-company"
                class="mb-4 block text-sm font-semibold tracking-[0.14em] text-brand uppercase transition-colors"
              >
                Are you representing a company or trade?
              </label>
              <input
                id="contact-company"
                name="company"
                type="text"
                placeholder="Company Name (Optional)"
                class="w-full border-b border-border-strong bg-transparent px-0 py-3 text-2xl font-display-light text-text-heading placeholder:text-text-muted/40 transition-colors focus:border-brand focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Phone (Optional) -->
            <div class="relative group contact-reveal">
              <label
                for="contact-phone"
                class="mb-4 block text-sm font-semibold tracking-[0.14em] text-brand uppercase transition-colors"
              >
                What is your phone number?
              </label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                placeholder="+1 (555) 000-0000 (Optional)"
                class="w-full border-b border-border-strong bg-transparent px-0 py-3 text-2xl font-display-light text-text-heading placeholder:text-text-muted/40 transition-colors focus:border-brand focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Country / Region (Optional) -->
            <div class="relative group contact-reveal">
              <label
                for="contact-country"
                class="mb-4 block text-sm font-semibold tracking-[0.14em] text-brand uppercase transition-colors"
              >
                Where are you located?
              </label>
              <input
                id="contact-country"
                name="country"
                type="text"
                placeholder="City, Country (Optional)"
                class="w-full border-b border-border-strong bg-transparent px-0 py-3 text-2xl font-display-light text-text-heading placeholder:text-text-muted/40 transition-colors focus:border-brand focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Product of Interest (Optional) -->
            <div class="relative group contact-reveal">
              <label
                for="contact-product"
                class="mb-4 block text-sm font-semibold tracking-[0.14em] text-brand uppercase transition-colors"
              >
                Which collection or product interests you?
              </label>
              <input
                id="contact-product"
                name="product"
                type="text"
                placeholder="e.g. Coastal Sectional Sofa (Optional)"
                class="w-full border-b border-border-strong bg-transparent px-0 py-3 text-2xl font-display-light text-text-heading placeholder:text-text-muted/40 transition-colors focus:border-brand focus:outline-none focus:ring-0"
              />
            </div>

            <!-- Message -->
            <div class="relative group contact-reveal">
              <label
                for="contact-message"
                class="mb-4 block text-sm font-semibold tracking-[0.14em] text-brand uppercase transition-colors"
              >
                Tell us about the space you are designing... *
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="3"
                placeholder="I am looking to furnish..."
                required
                class="w-full resize-none border-b border-border-strong bg-transparent px-0 py-3 text-2xl font-display-light text-text-heading placeholder:text-text-muted/40 transition-colors focus:border-brand focus:outline-none focus:ring-0 leading-relaxed"
              ></textarea>
            </div>

            <!-- Error Banner -->
            <div
              id="contact-error-msg"
              class="hidden rounded-md border border-red-200 bg-red-50/70 p-4 text-sm text-red-700 transition-all duration-300"
            >
              <div class="flex items-center justify-between gap-3">
                <span id="contact-error-text">An error occurred while submitting your message.</span>
                <button
                  id="contact-retry-btn"
                  type="button"
                  class="font-semibold uppercase text-xs tracking-wider text-red-800 underline hover:text-red-950 transition-colors"
                >
                  Retry
                </button>
              </div>
            </div>

            <!-- Submit -->
            <div class="pt-8 contact-reveal">
              <button
                id="contact-submit-btn"
                type="submit"
                class="group inline-flex items-center gap-4 rounded-button border border-brand bg-transparent px-10 py-4 text-sm font-medium tracking-[0.1em] text-brand uppercase transition-all duration-300 hover:bg-brand hover:text-white focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 active:scale-[0.985] disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <span id="contact-btn-text">Start the Conversation</span>
                <span
                  id="contact-btn-arrow"
                  class="inline-block h-px w-6 bg-brand transition-all duration-300 group-hover:w-10 group-hover:bg-white"
                />
              </button>
            </div>
          </form>

          <div
            id="contact-success-msg"
            class="hidden mt-8 max-w-md"
          >
            <h3 class="font-display-medium text-3xl text-text-heading mb-4">Thank You.</h3>
            <p class="text-lg leading-relaxed text-text-body mb-8">We have received your message. Our team will review your project details and reach out within one business day.</p>
            <button
              id="contact-reset-btn"
              type="button"
              class="group inline-flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.12em] text-brand hover:text-brand-hover transition-colors"
            >
              <span>Send Another Message</span>
              <span
                class="inline-block h-px w-6 bg-brand transition-all duration-300 group-hover:w-10"
              />
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Contact Page Specific Motion Primitives */
    .contact-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 600ms cubic-bezier(0.25, 1, 0.3, 1),
                  transform 600ms cubic-bezier(0.25, 1, 0.3, 1);
    }
    .contact-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .contact-reveal-image img {
      opacity: 0;
      transition: opacity 800ms cubic-bezier(0.25, 1, 0.3, 1),
                  transform 1200ms cubic-bezier(0.25, 1, 0.3, 1);
    }
    .contact-reveal-image.is-visible img {
      opacity: 1;
      transform: scale(1);
    }
    @media (prefers-reduced-motion: reduce) {
      .contact-reveal, .contact-reveal-image img {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <script is:inline>
    (function() {
      const form = document.getElementById('contact-enquiry-form');
      const submitBtn = document.getElementById('contact-submit-btn');
      const btnText = document.getElementById('contact-btn-text');
      const successMsg = document.getElementById('contact-success-msg');
      const resetBtn = document.getElementById('contact-reset-btn');
      const errorMsg = document.getElementById('contact-error-msg');
      const errorText = document.getElementById('contact-error-text');
      const retryBtn = document.getElementById('contact-retry-btn');

      function showError(msg) {
        if (errorText && errorMsg) {
          errorText.textContent = msg || 'An error occurred while submitting your message.';
          errorMsg.classList.remove('hidden');
        }
      }

      function hideError() {
        if (errorMsg) {
          errorMsg.classList.add('hidden');
        }
      }

      function collectMetadata() {
        const urlParams = new URLSearchParams(window.location.search);
        return {
          timestamp: new Date().toISOString(),
          sourceUrl: window.location.href,
          referrer: document.referrer || 'Direct',
          browserLang: navigator.language || 'en',
          utmSource: urlParams.get('utm_source') || undefined,
          utmMedium: urlParams.get('utm_medium') || undefined,
          utmCampaign: urlParams.get('utm_campaign') || undefined,
        };
      }

      async function handleFormSubmit(e) {
        if (e) e.preventDefault();
        hideError();

        const nameInput = document.getElementById('contact-name');
        const emailInput = document.getElementById('contact-email');
        const messageInput = document.getElementById('contact-message');
        const companyInput = document.getElementById('contact-company');
        const phoneInput = document.getElementById('contact-phone');
        const countryInput = document.getElementById('contact-country');
        const productInput = document.getElementById('contact-product');
        const honeypotInput = document.getElementById('contact-honeypot');

        const name = nameInput ? nameInput.value.trim() : '';
        const email = emailInput ? emailInput.value.trim() : '';
        const message = messageInput ? messageInput.value.trim() : '';

        // Client-side quick validation
        if (!name) {
          showError('Please enter your name.');
          return;
        }
        if (!email || !email.includes('@')) {
          showError('Please enter a valid email address.');
          return;
        }
        if (!message || message.length < 10) {
          showError('Please enter a message of at least 10 characters.');
          return;
        }

        // Set Loading State
        if (submitBtn && btnText) {
          btnText.textContent = 'Sending…';
          submitBtn.setAttribute('disabled', 'true');
        }

        const payload = {
          name: name,
          email: email,
          message: message,
          company: companyInput ? companyInput.value.trim() : '',
          phone: phoneInput ? phoneInput.value.trim() : '',
          country: countryInput ? countryInput.value.trim() : '',
          productOfInterest: productInput ? productInput.value.trim() : '',
          honeypot: honeypotInput ? honeypotInput.value.trim() : '',
        };

        const metadata = collectMetadata();

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payload, metadata }),
          });

          const data = await response.json().catch(function() { return {}; });

          if (response.ok && data.success) {
            // Success Transition
            if (form && successMsg) {
              form.classList.add('hidden');
              successMsg.classList.remove('hidden');
            }
          } else {
            // Error State
            const errStr = data.error || 'Failed to send message. Please try again.';
            showError(errStr);
            if (submitBtn && btnText) {
              btnText.textContent = 'Start the Conversation';
              submitBtn.removeAttribute('disabled');
            }
          }
        } catch (err) {
          console.error('Fetch error submitting contact form:', err);
          showError('Network error. Please check your internet connection and retry.');
          if (submitBtn && btnText) {
            btnText.textContent = 'Start the Conversation';
            submitBtn.removeAttribute('disabled');
          }
        }
      }

      if (form) {
        form.addEventListener('submit', handleFormSubmit);
      }

      if (retryBtn) {
        retryBtn.addEventListener('click', handleFormSubmit);
      }

      if (resetBtn && form && successMsg && submitBtn && btnText) {
        resetBtn.addEventListener('click', function() {
          form.reset();
          hideError();
          btnText.textContent = 'Start the Conversation';
          submitBtn.removeAttribute('disabled');
          successMsg.classList.add('hidden');
          form.classList.remove('hidden');
        });
      }

      // Intersection Observer for scroll animations
      const reveals = document.querySelectorAll('.contact-reveal, .contact-reveal-image');
      if (reveals.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              const delay = Array.from(reveals).indexOf(entry.target) * 80;
              setTimeout(() => {
                entry.target.classList.add('is-visible');
              }, delay % 320);
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });
        
        reveals.forEach(function(el) { observer.observe(el); });
      } else {
        reveals.forEach(function(el) { el.classList.add('is-visible'); });
      }
    })();
  </script>

</MainLayout>
