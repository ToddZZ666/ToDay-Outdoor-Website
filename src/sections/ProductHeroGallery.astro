---
// ProductGallery — fixed viewport + translateX track
// Viewport width never changes regardless of total thumb count
// Hero grid ratio stays stable at 62/38
import '../sections/productDetail.css';

export interface Props {
  productName: string;
  images: { src: string; alt: string; thumb: string }[];
}

const { productName, images } = Astro.props;
const total = images.length;
---

<div class="detail-gallery" aria-label="Product images">
  <!-- Main Image -->
  <div class="detail-main-image-wrap">
    <img
      id="gallery-main-img"
      src={images[0].src}
      alt={images[0].alt}
      width="900"
      height="675"
    />
  </div>

  <!-- Thumbnail area: viewport + absolute arrows -->
  <div class="gallery-thumbs-area">
    <!-- Prev arrow (absolute, does not affect layout) -->
    <button
      class="gallery-thumb-arrow gallery-thumb-arrow--prev"
      id="gallery-arrow-prev"
      aria-label="Previous thumbnail"
      disabled
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    <!-- Fixed-width viewport — clips overflowing thumbs -->
    <div class="gallery-thumb-viewport" id="gallery-viewport">
      <div class="gallery-thumb-track" id="gallery-track" style="transform: translateX(0px)">
        {images.map((img, i) => (
          <button
            class={`gallery-thumb ${i === 0 ? 'active' : ''}`}
            data-index={i}
            aria-label={`View image ${i + 1}`}
          >
            <img src={img.thumb} alt="" width="96" height="96" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>

    <!-- Next arrow (absolute, does not affect layout) -->
    <button
      class="gallery-thumb-arrow gallery-thumb-arrow--next"
      id="gallery-arrow-next"
      aria-label="Next thumbnail"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>
</div>

<script>
// @ts-nocheck — client-side gallery script with explicit runtime null guards
(function () {
  var mainImg = document.getElementById('gallery-main-img');
  var track = document.getElementById('gallery-track');
  var viewport = document.getElementById('gallery-viewport');
  var prevBtn = document.getElementById('gallery-arrow-prev');
  var nextBtn = document.getElementById('gallery-arrow-next');
  var thumbs = Array.from(document.querySelectorAll('.gallery-thumb'));
  var total = thumbs.length;
  if (!mainImg || !track || !viewport || total === 0) return;
  mainImg = mainImg as HTMLImageElement;
  track = track as HTMLElement;
  viewport = viewport as HTMLElement;
  prevBtn = prevBtn as HTMLButtonElement;
  nextBtn = nextBtn as HTMLButtonElement;
  thumbs = thumbs as HTMLButtonElement[];

  function getVisible() {
    if (window.innerWidth >= 1024) return 4;
    if (window.innerWidth >= 640) return 3;
    return 2;
  }

  function measure() {
    if (thumbs.length === 0) return;
    const gap = parseFloat(window.getComputedStyle(track).gap) || 12;
    const w = thumbs[0].getBoundingClientRect().width;
    thumbStep = w + gap;
  }

  function go(i: number) {
    currentIdx = i;
    const visible = getVisible();
    if (i < slideOffset) slideOffset = i;
    else if (i >= slideOffset + visible) slideOffset = i - visible + 1;
    update();
  }

  function update() {
    const visible = getVisible();
    const maxStart = Math.max(0, total - visible);
    if (slideOffset > maxStart) slideOffset = maxStart;
    if (slideOffset < 0) slideOffset = 0;

    track.style.transform = 'translateX(' + (-slideOffset * thumbStep) + 'px)';

    thumbs.forEach(function (t, i) { t.classList.toggle('active', i === currentIdx); });

    prevBtn.disabled = slideOffset === 0;
    nextBtn.disabled = slideOffset >= maxStart;

    mainImg.style.opacity = '0';
    setTimeout(function () {
      const src = thumbs[currentIdx].querySelector('img')?.getAttribute('src');
      if (src) mainImg.src = src;
      mainImg.style.opacity = '1';
    }, 200);
  }

  // Thumb click
  thumbs.forEach(function (thumb, i) {
    thumb.addEventListener('click', function () { go(i); });
  });

  // Prev / Next buttons
  prevBtn.addEventListener('click', function () {
    if (slideOffset > 0) {
      slideOffset--;
      const visible = getVisible();
      if (currentIdx > slideOffset + visible - 1) currentIdx = slideOffset + visible - 1;
      else if (currentIdx < slideOffset) currentIdx = slideOffset;
      update();
    }
  });
  nextBtn.addEventListener('click', function () {
    const visible = getVisible();
    const maxStart = Math.max(0, total - visible);
    if (slideOffset < maxStart) {
      slideOffset++;
      if (currentIdx < slideOffset) currentIdx = slideOffset;
      else if (currentIdx > slideOffset + visible - 1) currentIdx = slideOffset + visible - 1;
      update();
    }
  });

  // Keyboard navigation on thumbnails — ArrowLeft/ArrowRight moves focus + selection
  viewport.addEventListener('keydown', function (e) {
    var target = e.target as HTMLElement;
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      const i = thumbs.indexOf(target as HTMLButtonElement);
      if (i > -1) go(i - 1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      const i = thumbs.indexOf(target as HTMLButtonElement);
      if (i > -1) go(i + 1);
    } else if (e.key === 'Home') {
      e.preventDefault();
      go(0);
    } else if (e.key === 'End') {
      e.preventDefault();
      go(total - 1);
    }
  });

  // Init
  var slideOffset = 0;
  var thumbStep = 0;
  var currentIdx = 0;
  measure();
  update();

  // Re-measure on resize
  var resizeTimer: ReturnType<typeof setTimeout> | undefined;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () { measure(); update(); }, 150);
  });
})();
</script>