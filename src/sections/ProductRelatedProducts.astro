---
// Complete the Space — related products grid
import '../sections/productDetail.css';

export interface Props {
  products: { name: string; price: number; image: string; slug: string }[];
  heading?: string;
  viewAllLink?: string;
}

const { products, heading = 'Complete the Space', viewAllLink = '/collection' } = Astro.props;

function formatPrice(p: number): string {
  return '$' + p.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}
---

<section class="detail-related" aria-label="Related products">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="detail-related-header">
      <h2 class="detail-related-heading">{heading}</h2>
      <a href={viewAllLink} class="detail-related-link">
        View All Collection
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>

    <!-- Grid -->
    <div class="detail-related-grid">
      {products.map((p) => (
        <a href={p.slug} class="detail-related-card">
          <div class="detail-related-image">
            <img src={p.image} alt={p.name} width="280" height="280" loading="lazy" />
          </div>
          <h3 class="detail-related-name">{p.name}</h3>
          <p class="detail-related-price">From {formatPrice(p.price)}</p>
        </a>
      ))}
    </div>
  </div>
</section>
